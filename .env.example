# Copy to .env for local development. Never commit .env.
# Load it with:  set -a; source .env; set +a

# Slack app → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...
# Slack app → Basic Information → App Credentials → Signing Secret
SLACK_SIGNING_SECRET=...
# The only channel the bot works in (right-click channel → View channel details → bottom of the About tab)
LEET_CHANNEL_ID=C0123456789
# Comma-separated Slack member IDs of admins (profile → ⋯ → Copy member ID)
ADMIN_SLACK_IDS=U0123456789,U0987654321
# Neon → your project → Connect → connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Long random string; cron-job.org sends it in the X-Cron-Secret header. Generate: openssl rand -hex 24
CRON_SECRET=
